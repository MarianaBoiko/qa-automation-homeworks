		{
			"name": "/types",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Array contains valid joke types\", function () {\r",
							"    const resp = pm.response.json();\r",
							"    \r",
							"    const validTypes = [\"general\", \"knock-knock\", \"programming\", \"dad\"];\r",
							"    \r",
							"    resp.forEach(function (type) {\r",
							"        pm.expect(validTypes).to.include(type);\r",
							"    });\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
