	"item": [
		{
			"name": "/jokes/random",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains expected joke properties\", function () {\r",
							"    const resp = pm.response.json();\r",
							"\r",
							"    pm.expect(resp).to.have.property(\"type\").that.is.a(\"string\");\r",
							"    pm.expect(resp).to.have.property(\"setup\").that.is.a(\"string\").and.not.empty;\r",
							"    pm.expect(resp).to.have.property(\"punchline\").that.is.a(\"string\").and.not.empty;\r",
							"    pm.expect(resp).to.have.property(\"id\").that.is.a(\"number\");\r",
							"    \r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{theJokeApiBaseUrl}}/jokes/random",
					"host": [
						"{{theJokeApiBaseUrl}}"
					],
					"path": [
						"jokes",
						"random"
					]
				}
			},
			"response": []
		},
